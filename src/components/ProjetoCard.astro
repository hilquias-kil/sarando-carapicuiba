---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  projeto: CollectionEntry<'projetos'>
  /** 2 where the grid follows the h1 directly, 3 where a section h2 introduces it. */
  nivel?: 2 | 3
}
const { projeto, nivel = 3 } = Astro.props
const { titulo, capa, capaAlt, linha } = projeto.data
const Titulo = `h${nivel}` as 'h2' | 'h3'
---

<article class="card projeto">
  <a href={`/projetos/${projeto.id}`}>
    <div class="card-media projeto__media">
      <Image src={capa} alt={capaAlt} />
      <div class="scrim-caption projeto__caption">
        <Titulo class="projeto__titulo">{titulo}</Titulo>
      </div>
    </div>
    <p class="projeto__linha">{linha}</p>
  </a>
</article>

<style>
  .projeto a {
    text-decoration: none;
    display: block;
  }
  .projeto__media {
    position: relative;
    aspect-ratio: 3 / 4;
  }
  .projeto__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.5rem 1rem 1rem;
    color: #fff;
  }
  /* The caption title keeps one size whether it renders as h2 or h3: the
     heading level answers to the page outline, not to the type ramp. */
  .projeto__titulo {
    font-size: var(--text-titulo);
    letter-spacing: normal;
  }
  .projeto__linha {
    margin-top: 0.7rem;
    font-size: var(--text-small);
    color: var(--color-ink-2);
  }
  .section--panel .projeto__linha {
    color: var(--color-on-panel-2);
  }
</style>
